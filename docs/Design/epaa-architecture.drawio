olor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="150" y="75" width="240" height="55" as="geometry"/></mxCell><mxCell id="g_alloc" value="allocation-service&amp;lt;br&amp;gt;POST /api/allocations/run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="78" width="200" height="50" as="geometry"/></mxCell><mxCell id="g_agents" value="Agents pipeline&amp;lt;br&amp;gt;(synchronous, on-demand)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4f46e5;strokeColor=#3730a3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="75" width="220" height="55" as="geometry"/></mxCell><mxCell id="g_admin" value="Platform /&amp;lt;br&amp;gt;Data Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="30" height="60" as="geometry"/></mxCell><mxCell id="g_dm" value="Admin Portal: Data Management&amp;lt;br&amp;gt;'Initiate Execution' (MANUAL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="150" y="225" width="240" height="55" as="geometry"/></mxCell><mxCell id="g_dl" value="Datalake API&amp;lt;br&amp;gt;POST /synthetic/generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="228" width="200" height="50" as="geometry"/></mxCell><mxCell id="g_airflow" value="Airflow DAG&amp;lt;br&amp;gt;(ASYNC execution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="228" width="200" height="50" as="geometry"/></mxCell><mxCell id="g_pg" value="Postgres + pgvector" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="200" height="45" as="geometry"/></mxCell><mxCell id="g_note" value="MANUAL: a manager/admin triggers from the portal (or any API client).&amp;lt;br&amp;gt;ASYNC (dashed): the Datalake API returns immediately and the Airflow DAG&amp;lt;br&amp;gt;generates + loads data in the background.&amp;lt;br&amp;gt;The 6-agent allocation runs synchronously per request — no scheduled auto-runs&amp;lt;br&amp;gt;yet (future: event-driven on brief submission)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="620" height="110" as="geometry"/></mxCell><mxCell id="eg_mgr_g_monitor_0" value="clicks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_mgr" target="g_monitor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_monitor_g_alloc_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_monitor" target="g_alloc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_alloc_g_agents_2" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_alloc" target="g_agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_agents_g_pg_3" value="read/write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_agents" target="g_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_admin_g_dm_4" value="clicks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_admin" target="g_dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_dm_g_dl_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_dm" target="g_d