Any API client&lt;br&gt;(programmatic, MANUAL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="185" width="240" height="50" as="geometry"/></mxCell><mxCell id="g_alloc" value="allocation-service&lt;br&gt;POST /api/allocations/run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="210" height="50" as="geometry"/></mxCell><mxCell id="g_agents" value="Agents pipeline (6 agents)&lt;br&gt;SYNCHRONOUS, on-demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4f46e5;strokeColor=#3730a3;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="115" width="230" height="55" as="geometry"/></mxCell><mxCell id="g_pg" value="Postgres + pgvector" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="710" y="215" width="230" height="45" as="geometry"/></mxCell><mxCell id="g_note" value="The 6-agent allocation pipeline runs SYNCHRONOUSLY per request —&lt;br&gt;triggered manually from the Agent Monitor or by any API client.&lt;br&gt;There are no scheduled/automatic agent runs yet&amp;#10;(future: event-driven trigger when a brief is submitted)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="620" height="100" as="geometry"/></mxCell><mxCell id="eg_mgr_g_monitor_0" value="clicks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_mgr" target="g_monitor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_monitor_g_alloc_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="g_monitor" target="g_alloc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eg_api_g_alloc_