# ─────────────────────────────────────────────────────────────
# Enterprise Project Allocation Agents — environment template
# Copy to `.env` and fill in. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── AWS / Bedrock ────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default
# Reasoning LLM for the agents (Claude Opus 4.7 on Bedrock)
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7-v1:0
# Embeddings model (Titan v2) for the Skill-Matching Agent
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Embedding provider selection ─────────────────────────────
# bedrock = Titan (cloud) · hf = HuggingFace MiniLM (local fallback)
EMBEDDING_PROVIDER=bedrock
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=1024

# ── Database profile ─────────────────────────────────────────
# h2 (default) = Spring services run on in-memory H2; no Postgres needed.
# postgres     = Spring services use Postgres+pgvector.
# Python/agents always use Postgres (pgvector required for embeddings).
DB_PROFILE=h2

# ── H2 (default for Spring services) ─────────────────────────
H2_URL=jdbc:h2:mem:epaa;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
H2_USER=sa
H2_PASSWORD=

# ── Postgres + pgvector ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=epaa
POSTGRES_USER=epaa
POSTGRES_PASSWORD=change-me-local
# JDBC form for Spring Boot services (used when DB_PROFILE=postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/epaa

# ── Optional standalone vector DB (alternative to pgvector) ──
VECTOR_BACKEND=pgvector
QDRANT_URL=http://localhost:6333

# ── Datalake (synthetic data) ────────────────────────────────
DATALAKE_API_PORT=8000
# Embedding provider: bedrock | hf | hash (offline deterministic fallback)
# Datalake/agents always use Postgres+pgvector regardless of Spring's DB_PROFILE.

# ── Agents service (Python / FastAPI) ────────────────────────
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8001
AGENTS_BASE_URL=http://localhost:8001
# Orchestrator: custom (hand-rolled v1) | langgraph (v2 graph; needs the langgraph extra)
ORCHESTRATOR=custom
# LLM backend: auto | strands | bedrock | langchain | openai | ollama | heuristic
LLM_PROVIDER=auto

# ── Middleware (Spring Boot) ports ───────────────────────────
API_GATEWAY_PORT=8080
EMPLOYEE_SERVICE_PORT=8081
PROJECT_SERVICE_PORT=8082
ALLOCATION_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
REPORTING_SERVICE_PORT=8085

# ── Portals (Angular dev servers) ────────────────────────────
ADMIN_PORTAL_PORT=4200
PROJECTS_PORTAL_PORT=4201
# Base URL the portals call (the gateway)
API_BASE_URL=http://localhost:8080

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# ── Airflow (Datalake synthetic-data DAG runtime) ────────────
AIRFLOW_PORT=8088
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── Notifications (local = log/SMTP stub; AWS = SES) ─────────
NOTIFICATION_CHANNEL=log
SMTP_HOST=localhost
SMTP_PORT=1025
