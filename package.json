{
  "name": "enterprise-project-allocation-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Hands-on implementation of the IEEE paper MCP-AI: a multi-agent LLM architecture for automated enterprise project allocation. Root orchestration for local-first dev.",
  "license": "Apache-2.0",
  "author": "javakishore-veleti",
  "repository": {
    "type": "git",
    "url": "https://github.com/javakishore-veleti/Enterprise-Project-Allocation-Agents.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "secrets:gen": "node DevOps/Local/scripts/gen-spring-secrets.mjs",

    "prestart": "npm run secrets:gen",
    "start": "bash DevOps/Local/docker-all-up.sh all",
    "stop": "bash DevOps/Local/docker-all-down.sh all",
    "status": "bash DevOps/Local/docker-all-status.sh",

    "start:infra": "bash DevOps/Local/docker-all-up.sh infra",
    "stop:infra": "bash DevOps/Local/docker-all-down.sh infra",

    "start:postgres": "bash DevOps/Local/docker-all-up.sh postgres",
    "stop:postgres": "bash DevOps/Local/docker-all-down.sh postgres",

    "start:observability": "bash DevOps/Local/docker-all-up.sh observability",
    "stop:observability": "bash DevOps/Local/docker-all-down.sh observability",

    "start:airflow": "bash DevOps/Local/docker-all-up.sh airflow",
    "stop:airflow": "bash DevOps/Local/docker-all-down.sh airflow",

    "start:datalake": "bash DevOps/Local/docker-all-up.sh datalake",
    "stop:datalake": "bash DevOps/Local/docker-all-down.sh datalake",

    "start:vectordb": "bash DevOps/Local/docker-all-up.sh vectordb",
    "stop:vectordb": "bash DevOps/Local/docker-all-down.sh vectordb",

    "start:agents": "bash DevOps/Local/docker-all-up.sh agents",
    "stop:agents": "bash DevOps/Local/docker-all-down.sh agents",

    "prestart:middleware": "npm run secrets:gen",
    "start:middleware": "bash DevOps/Local/docker-all-up.sh middleware",
    "stop:middleware": "bash DevOps/Local/docker-all-down.sh middleware",

    "start:portals": "bash DevOps/Local/docker-all-up.sh portals",
    "stop:portals": "bash DevOps/Local/docker-all-down.sh portals",

    "seed": "curl -s -X POST http://localhost:8000/synthetic/generate"
  }
}
